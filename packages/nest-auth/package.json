{
  "name": "@wdev-studio/nest-auth",
  "version": "0.1.0",
  "description": "Core authentication engine for NestJS - AuthModule, OAuth Manager, JWT, Session, Guards",
  "license": "MIT",
  "author": "Wdev Studio",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "bun run build.ts",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@wdev-studio/nest-auth-types": "workspace:*",
    "jose": "^5.2.0"
  },
  "peerDependencies": {
    "@nestjs/common": ">=10.0.0",
    "@nestjs/core": ">=10.0.0",
    "reflect-metadata": ">=0.2.0",
    "typescript": ">=5.4.0"
  },
  "devDependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "reflect-metadata": "^0.2.0",
    "@nestjs/platform-express": "^10.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wdev-studio-com/nest-packages.git",
    "directory": "packages/nest-auth"
  },
  "bugs": {
    "url": "https://github.com/wdev-studio-com/nest-packages/issues"
  },
  "homepage": "https://github.com/wdev-studio-com/nest-packages/tree/main/packages/nest-auth",
  "keywords": [
    "nest",
    "nestjs",
    "auth",
    "oauth",
    "jwt",
    "session",
    "authentication",
    "typescript"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
