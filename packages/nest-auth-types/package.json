    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "bun run build.ts",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "typescript": ">=5.4.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wdev-studio-com/nest-packages.git",
    "directory": "packages/nest-auth-types"
  },
  "bugs": {
    "url": "https://github.com/wdev-studio-com/nest-packages/issues"
  },
  "homepage": "https://github.com/wdev-studio-com/nest-packages/tree/main/packages/nest-auth-types",
  "keywords": [
    "nest",
    "nestjs",
    "auth",
    "types",
    "oauth",
    "openid",
    "typescript"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
