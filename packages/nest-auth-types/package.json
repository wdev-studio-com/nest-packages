{
  "name": "@wdev-studio/nest-auth-types",
  "version": "0.1.1",
  "description": "Shared contracts, interfaces and types for @wdev-studio/nest-auth ecosystem",
  "license": "MIT",
  "author": "Wdev Studio",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
